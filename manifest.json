{
  "schemaVersion": 1,
  "id": "ma-bar",
  "name": "MA Bar",
  "version": "0.11.0",
  "author": "Tony Lucent",
  "license": "MIT",
  "description": "Control Music Assistant from the Omarchy bar: now-playing, play/pause, skip, and a dropdown to browse, search and play music, audiobooks and podcasts.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "MA Bar",
    "description": "Now-playing and playback controls for your Music Assistant server.",
    "category": "Media",
    "aliases": [
      "music assistant",
      "music",
      "audiobooks",
      "podcasts"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "pollSeconds": 3
    },
    "schema": [
      {
        "key": "pollSeconds",
        "type": "integer",
        "label": "Refresh now-playing every",
        "min": 2,
        "max": 30,
        "step": 1,
        "defaultValue": 3,
        "description": "Seconds between now-playing checks."
      }
    ]
  }
}
